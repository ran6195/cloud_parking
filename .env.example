APP_NAME="Cloud Parking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Motore prenotazioni (App\Engine): Postgres, schema dedicato.
# In locale: container di docker-compose.yml (docker compose up -d).
# Su Laravel Cloud NON definirle (nemmeno vuote): si ereditano le variabili DB_* iniettate da Cloud.
ENGINE_DB_HOST=127.0.0.1
ENGINE_DB_PORT=5432
ENGINE_DB_DATABASE=parking
ENGINE_DB_USERNAME=parking
ENGINE_DB_PASSWORD=parking
ENGINE_DB_SCHEMA=engine

# Motore: validità dei preventivi, limiti di richieste al minuto, base dei problem+json (config/engine.php)
ENGINE_QUOTE_TTL_MINUTES=30
ENGINE_RATE_LIMIT=120
ENGINE_RATE_LIMIT_DISCOUNTS=10
ENGINE_RATE_LIMIT_RESERVATIONS=20
# Disco delle ricevute (su Cloud l'Object Storage) e pagina di cancellazione linkata nelle email ({token})
ENGINE_RECEIPTS_DISK=local
ENGINE_CANCELLATION_URL=

# Pagamenti online: fake (simulato, vietato in produzione) oppure paypal. Vedi docs/payments.md
ENGINE_PAYMENTS_DRIVER=fake
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# ENGINE_PROBLEM_TYPE_BASE=https://docs.parcheggio.example/errors/

# DB legacy CCParking (solo import): docker compose --profile legacy up -d legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3307
LEGACY_DB_DATABASE=legacy
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
